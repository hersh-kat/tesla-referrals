---
import Layout from '../../layouts/Layout.astro';
import { countries } from '../../data/countries';
import { posts } from '../../data/posts';

const country = countries.find((c) => c.slug === 'uk')!;
const title = 'Tesla Referral Code UK | Blog';
const description =
  'Guides on the Tesla UK referral programme: how the perks work, what 650 free Supercharging miles is worth, and how to use a referral code in store.';
---
<Layout title={title} description={description} country={country}>
  <section class="bg-white">
    <div class="container-narrow py-16 sm:py-20 max-w-3xl">
      <p class="text-xs uppercase tracking-widest text-tesla-grey mb-4">Blog</p>
      <h1 class="text-3xl sm:text-5xl font-medium leading-tight">
        Tesla referral guides
      </h1>
      <p class="mt-4 text-tesla-grey">
        Honest, UK-specific guides on the Tesla referral programme. Written by an
        existing Tesla owner.
      </p>

      <ul class="mt-12 divide-y divide-black/10 border-t border-b border-black/10">
        {posts.map((p) => (
          <li class="py-6">
            <a
              href={`/blog/${p.slug}/`}
              class="block hover:text-tesla-red transition-colors"
            >
              <h2 class="text-xl font-medium">{p.title}</h2>
              <p class="mt-2 text-sm text-tesla-grey">{p.description}</p>
              <p class="mt-3 text-xs text-tesla-grey">
                {new Date(p.date).toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })} · {p.readTime}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll('ul a[href^="/blog/"]').forEach((link) => {
      link.addEventListener('click', () => {
        const title = link.querySelector('h2')?.textContent?.trim();
        const slug = link.getAttribute('href').replace('/blog/', '').replace('/', '');
        window.posthog?.capture('blog_post_clicked', {
          post_title: title,
          post_slug: slug,
        });
      });
    });
  </script>
</Layout>
