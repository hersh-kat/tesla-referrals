---
interface Props {
  title: string;
  eyebrow?: string;
  date: string;
  readTime?: string;
}

const { title, eyebrow = 'Tesla referral guide', date, readTime } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<article class="bg-white">
  <div class="container-narrow py-16 sm:py-20 max-w-3xl">
    <p class="text-xs uppercase tracking-widest text-tesla-grey mb-4">{eyebrow}</p>
    <h1 class="text-3xl sm:text-5xl font-medium leading-tight">{title}</h1>
    <p class="mt-4 text-sm text-tesla-grey">
      <time datetime={date}>{formattedDate}</time>
      {readTime && (<span class="mx-2">·</span><span>{readTime}</span>)}
    </p>
    <div class="mt-10 space-y-5 text-base leading-relaxed blog-body">
      <slot />
    </div>
  </div>
</article>

<style is:global>
  .blog-body h2 {
    font-size: 1.375rem;
    font-weight: 500;
    padding-top: 1.5rem;
    line-height: 1.3;
  }
  .blog-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    padding-top: 1rem;
  }
  .blog-body p {
    line-height: 1.7;
  }
  .blog-body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-body a:hover {
    color: #cc0000;
  }
  .blog-body ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .blog-body ul li {
    line-height: 1.7;
    padding-bottom: 0.25rem;
  }
  .blog-body blockquote {
    border-left: 3px solid #cc0000;
    padding-left: 1rem;
    color: #5c5e62;
    font-style: italic;
  }
</style>
