---
import type { PageContent } from '../../data/content';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;

const videos = [
  {
    id: 'gQ92igDGBHQ',
    title: 'Introducing Model Y Standard & Model 3 Standard | Tesla',
  },
  {
    id: 'DYcNfFeRPIk',
    title: 'Designing the New Model Y Performance | Tesla',
  },
];
---
<section class="bg-tesla-bg">
  <div class="container-narrow py-16 sm:py-20">
    <h2 class="text-2xl sm:text-3xl font-medium text-center mb-10">
      {content.videosTitle}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {videos.map((v) => (
        <div class="aspect-video rounded-lg overflow-hidden bg-black">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${v.id}`}
            title={v.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="w-full h-full"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      ))}
    </div>
  </div>
</section>
