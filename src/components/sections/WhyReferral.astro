---
import type { PageContent } from '../../data/content';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
---
<section class="bg-white">
  <div class="container-narrow py-16 sm:py-20 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-medium mb-6">
      {content.whyTitle}
    </h2>
    <div class="prose prose-tesla text-base text-tesla-black leading-relaxed space-y-4">
      {content.whyBody.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>
