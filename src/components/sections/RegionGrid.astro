---
import {
  countriesByRegion,
  getCountryHref,
  getLanguageHref,
  regions,
} from '../../data/countries';
import type { PageContent } from '../../data/content';

interface Props {
  content: PageContent;
}

const { content } = Astro.props;
const grouped = countriesByRegion();
---
<section class="bg-tesla-bg">
  <div class="container-narrow py-16 sm:py-20">
    <h2 class="text-2xl sm:text-3xl font-medium text-center mb-2">
      {content.allCountriesTitle}
    </h2>
    <p class="text-center text-tesla-grey mb-10 max-w-xl mx-auto">
      {content.allCountriesIntro}
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {regions.map((r) => {
        const list = grouped[r.key];
        if (!list || list.length === 0) return null;
        return (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-tesla-grey mb-3">
              {r.label}
            </h3>
            <ul class="space-y-3">
              {list.map((c) => (
                <li>
                  <a
                    href={getCountryHref(c)}
                    rel={c.hasLandingPage ? undefined : 'nofollow'}
                    class="group flex items-center gap-2 text-sm hover:text-tesla-grey"
                  >
                    <span aria-hidden="true">{c.flag}</span>
                    <span class="font-medium text-tesla-black group-hover:text-tesla-grey">
                      {c.nativeName}
                    </span>
                  </a>
                  {c.languages.length > 1 && (
                    <div class="mt-1 ml-6 flex flex-wrap gap-x-3 gap-y-1">
                      {c.languages.map((lang) => (
                        <a
                          href={getLanguageHref(c, lang)}
                          rel="nofollow"
                          class="text-xs text-tesla-grey hover:text-tesla-black"
                        >
                          {lang.label}
                        </a>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>
