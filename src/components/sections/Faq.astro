---
import { getReferralUrl, type Country } from '../../data/countries';
import type { PageContent } from '../../data/content';

interface Props {
  country: Country;
  content: PageContent;
}

const { country, content } = Astro.props;
const referralUrl = getReferralUrl(country);
const faqs = content.faqs;
---
<section id="faq" class="bg-white">
  <div class="container-narrow py-16 sm:py-20 max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-medium text-center mb-10">
      {content.faqTitle}
    </h2>
    <div class="divide-y divide-black/10 border-t border-b border-black/10">
      {faqs.map((f, i) => (
        <details class="group py-4" open={i === 0}>
          <summary class="flex justify-between items-center cursor-pointer list-none">
            <h3 class="text-base font-medium pr-4">{f.q}</h3>
            <svg
              class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-180"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="mt-3 text-sm text-tesla-grey leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href={referralUrl} rel="nofollow" class="btn-primary" data-cta="faq">
        {content.ctaUseReferral}
      </a>
    </div>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })}
/>
