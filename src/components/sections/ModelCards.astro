---
import {
  getOrderUrl,
  getInventoryUrl,
  getReferralUrl,
  type Country,
} from '../../data/countries';
import type { PageContent } from '../../data/content';
import type { ModelKey } from '../../data/models';

interface Props {
  country: Country;
  content: PageContent;
}

const { country, content } = Astro.props;

type CardConfig = {
  key: ModelKey | 'inventory';
  name: string;
  subtitle: string | null;
  image: string;
  orderHref?: string;
  inventoryHref?: string;
  size: 'wide' | 'half';
};

// Pull perk text per model from content. `null` = hide card entirely.
// Empty string `''` = show card without a subtitle (e.g. AU Model Y).
const perks = content.modelPerks;

const rawCards: Array<CardConfig | null> = [
  perks.my !== null
    ? {
        key: 'my',
        name: 'Model Y',
        subtitle: perks.my || null,
        image: '/models/model_y_nv36.avif',
        orderHref: getOrderUrl(country, 'my'),
        inventoryHref: getInventoryUrl(country, 'my'),
        size: 'wide',
      }
    : null,
  perks.m3 !== null
    ? {
        key: 'm3',
        name: 'Model 3',
        subtitle: perks.m3 || null,
        image: '/models/modelnv35.avif',
        orderHref: getOrderUrl(country, 'm3'),
        inventoryHref: getInventoryUrl(country, 'm3'),
        size: 'half',
      }
    : null,
  perks.mx !== null
    ? {
        key: 'mx',
        name: 'Model X',
        subtitle: perks.mx || null,
        image: '/models/model_x.avif',
        orderHref: getOrderUrl(country, 'mx'),
        inventoryHref: getInventoryUrl(country, 'mx'),
        size: 'half',
      }
    : null,
  perks.ms !== null
    ? {
        key: 'ms',
        name: 'Model S',
        subtitle: perks.ms || null,
        image: '/models/model_s.avif',
        orderHref: getOrderUrl(country, 'ms'),
        inventoryHref: getInventoryUrl(country, 'ms'),
        size: 'half',
      }
    : null,
  {
    key: 'inventory',
    name: content.inventoryCardTitle,
    subtitle: content.bothPerksSummary,
    image: '/models/inventory.avif',
    orderHref: getReferralUrl(country),
    size: 'half',
  },
];

const cards = rawCards.filter((c): c is CardConfig => c !== null);
const wide = cards.filter((c) => c.size === 'wide');
const half = cards.filter((c) => c.size === 'half');
---
<section id="models" class="bg-white">
  <div class="container-narrow py-12 sm:py-16">
    <h2 class="sr-only">{content.modelsTitle}</h2>

    <div class="space-y-4 sm:space-y-6">
      {wide.map((c) => (
        <div class="model-card aspect-[21/9] sm:aspect-[24/9]" data-card={c.key}>
          <img src={c.image} alt={`Tesla ${c.name}`} loading="eager" decoding="async" />
          <div class="model-card-content">
            <header class="model-card-header">
              <h3>{c.name}</h3>
              {c.subtitle && <p>{c.subtitle}</p>}
            </header>
            <div class="model-card-buttons">
              {c.orderHref && (
                <a
                  href={c.orderHref}
                  rel="nofollow"
                  class="model-btn model-btn-primary"
                  data-cta={`${c.key}-order`}
                >
                  {content.ctaOrder}
                </a>
              )}
              {c.inventoryHref && (
                <a
                  href={c.inventoryHref}
                  rel="nofollow"
                  class="model-btn model-btn-secondary"
                  data-cta={`${c.key}-inventory`}
                >
                  {content.ctaInventory}
                </a>
              )}
            </div>
          </div>
        </div>
      ))}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {half.map((c) => (
          <div class="model-card aspect-[4/3] sm:aspect-[16/10]" data-card={c.key}>
            <img src={c.image} alt={`Tesla ${c.name}`} loading="lazy" decoding="async" />
            <div class="model-card-content">
              <header class="model-card-header">
                <h3>{c.name}</h3>
                {c.subtitle && <p>{c.subtitle}</p>}
              </header>
              <div class="model-card-buttons">
                {c.orderHref && (
                  <a
                    href={c.orderHref}
                    rel="nofollow"
                    class="model-btn model-btn-primary"
                    data-cta={`${c.key}-order`}
                  >
                    {content.ctaOrder}
                  </a>
                )}
                {c.inventoryHref && (
                  <a
                    href={c.inventoryHref}
                    rel="nofollow"
                    class="model-btn model-btn-secondary"
                    data-cta={`${c.key}-inventory`}
                  >
                    {content.ctaInventory}
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .model-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: #000;
    color: #fff;
    text-decoration: none;
  }
  .model-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .model-card:hover img {
    transform: scale(1.02);
  }
  .model-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.1) 35%,
      rgba(0, 0, 0, 0.1) 60%,
      rgba(0, 0, 0, 0.65) 100%
    );
    pointer-events: none;
  }
  .model-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 28px 16px;
    text-align: center;
  }
  .model-card-header h3 {
    font-size: 1.5rem;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .model-card-header p {
    margin-top: 4px;
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 1;
  }
  .model-card-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .model-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    padding: 9px 22px;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .model-btn-primary {
    background: rgba(244, 244, 244, 0.85);
    color: #171a20;
  }
  .model-btn-primary:hover {
    background: rgba(244, 244, 244, 1);
  }
  .model-btn-secondary {
    background: rgba(23, 26, 32, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.8);
  }
  .model-btn-secondary:hover {
    background: rgba(23, 26, 32, 0.85);
  }

  @media (min-width: 640px) {
    .model-card-content {
      padding: 40px 24px;
    }
    .model-card-header h3 {
      font-size: 2.25rem;
    }
    .model-card-header p {
      font-size: 1rem;
      font-weight: 600;
      margin-top: 6px;
    }
  }
</style>
