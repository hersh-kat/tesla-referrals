---
import { getReferralUrl, type Country } from '../../data/countries';
import type { PageContent } from '../../data/content';

interface Props {
  country: Country;
  content: PageContent;
}

const { country, content } = Astro.props;
const referralUrl = getReferralUrl(country);
---
<section id="how" class="bg-tesla-bg">
  <div class="container-narrow py-16 sm:py-20">
    <h2 class="text-2xl sm:text-3xl font-medium text-center mb-12">
      {content.howTitle}
    </h2>
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {content.steps.map((s) => (
        <li class="bg-white rounded-lg p-6">
          <div class="text-tesla-red font-mono text-sm">{s.n}</div>
          <h3 class="text-lg font-medium mt-2">{s.title}</h3>
          <p class="text-sm text-tesla-grey mt-2 leading-relaxed">{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 text-center">
      <a href={referralUrl} rel="nofollow" class="btn-primary" data-cta="how-it-works">
        {content.ctaStartOrder}
      </a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ countryCode: country.code, countryName: country.name }}>
  document.querySelector('[data-cta="how-it-works"]')?.addEventListener('click', () => {
    window.posthog?.capture('how_it_works_cta_clicked', {
      country_code: countryCode,
      country_name: countryName,
    });
  });
</script>
