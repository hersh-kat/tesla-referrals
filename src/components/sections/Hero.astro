---
import { getReferralUrl, type Country } from '../../data/countries';
import type { PageContent } from '../../data/content';

interface Props {
  country: Country;
  content: PageContent;
}

const { country, content } = Astro.props;
const referralUrl = getReferralUrl(country);
---
<section class="bg-white">
  <div class="container-narrow pt-16 pb-12 sm:pt-24 sm:pb-20 text-center">
    <p class="text-xs uppercase tracking-widest text-tesla-grey mb-4">
      {content.heroEyebrow}
    </p>
    <h1 class="text-4xl sm:text-6xl font-medium text-tesla-black leading-tight">
      {content.heroHeadlineMain}
      <span class="block text-tesla-grey font-light">{content.heroHeadlineSub}</span>
    </h1>
    <p class="mt-6 text-base sm:text-lg text-tesla-grey max-w-2xl mx-auto">
      {content.heroBody}
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={referralUrl}
        rel="nofollow"
        class="btn-primary text-base"
        data-cta="hero-primary"
      >
        {content.ctaUseReferral}
      </a>
      <a href="#how" class="btn-secondary text-base">{content.ctaHowItWorks}</a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ countryCode: country.code, countryName: country.name }}>
  document.querySelector('[data-cta="hero-primary"]')?.addEventListener('click', () => {
    window.posthog?.capture('referral_link_clicked', {
      cta_location: 'hero',
      country_code: countryCode,
      country_name: countryName,
    });
  });
</script>
