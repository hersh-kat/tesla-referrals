---
import {
  countriesByRegion,
  getCountryHref,
  getLanguageHref,
  regions,
  type Country,
} from '../data/countries';

interface Props {
  current: Country;
}

const { current } = Astro.props;
const grouped = countriesByRegion();
---
<div class="relative inline-block text-left" data-country-selector>
  <button
    type="button"
    class="inline-flex items-center gap-2 text-sm text-tesla-black hover:text-tesla-grey transition-colors"
    aria-haspopup="true"
    aria-expanded="false"
    data-country-toggle
  >
    <span aria-hidden="true">{current.flag}</span>
    <span class="hidden sm:inline">{current.name}</span>
    <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M3 4.5 6 7.5l3-3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div
    class="hidden absolute right-0 mt-2 w-[22rem] max-w-[calc(100vw-1rem)] origin-top-right rounded-md bg-white shadow-xl ring-1 ring-black/10 z-50"
    data-country-menu
  >
    <div class="max-h-[28rem] overflow-y-auto p-3" role="menu">
      {regions.map((r) => {
        const list = grouped[r.key];
        if (!list || list.length === 0) return null;
        return (
          <div class="mb-3 last:mb-0">
            <h4 class="px-2 py-1 text-[11px] font-semibold uppercase tracking-wider text-tesla-grey">
              {r.label}
            </h4>
            <ul>
              {list.map((c) => (
                <li class="py-0.5">
                  {c.languages.length === 1 ? (
                    <a
                      href={getCountryHref(c)}
                      rel={c.hasLandingPage ? undefined : 'nofollow'}
                      class={`flex items-center gap-2 rounded px-2 py-1.5 text-sm hover:bg-tesla-bg ${c.code === current.code ? 'font-semibold' : ''}`}
                      role="menuitem"
                    >
                      <span aria-hidden="true">{c.flag}</span>
                      <span class="flex-1">{c.nativeName}</span>
                    </a>
                  ) : (
                    <div class={`px-2 py-1.5 ${c.code === current.code ? 'font-semibold' : ''}`}>
                      <div class="flex items-center gap-2 text-sm">
                        <span aria-hidden="true">{c.flag}</span>
                        <span>{c.nativeName}</span>
                      </div>
                      <div class="mt-1 flex flex-wrap gap-1 pl-6">
                        {c.languages.map((lang) => (
                          <a
                            href={getLanguageHref(c, lang)}
                            rel="nofollow"
                            class="rounded border border-black/10 px-2 py-0.5 text-xs text-tesla-grey hover:border-tesla-black hover:text-tesla-black"
                            role="menuitem"
                          >
                            {lang.label}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-country-selector]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-country-toggle]');
    const menu = root.querySelector<HTMLElement>('[data-country-menu]');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
